# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# sherpa-onnx's JNI reads config fields and builds results by name.
-keep class com.k2fsa.sherpa.onnx.** { *; }

# R8 partial (packageScope) bug: app code outside the scope pins the Kotlin multi-file facade part it calls (e.g.
# StringsKt__StringNumberConversionsJVMKt for toFloatOrNull), then R8 repackages an unpinned part in the same
# package-private inheritance chain and the app dies on start with IllegalAccessError. Keep the parts in place.
-keep,allowshrinking,allowoptimization,allowobfuscation class kotlin.**Kt__*, kotlinx.**Kt__*
